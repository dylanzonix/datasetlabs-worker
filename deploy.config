# deploy.config - Worker deployment configuration

# Azure resources
RESOURCE_GROUP=datasetlabs-rg
CONTAINER_APP_NAME=datasetlabs-worker
ENVIRONMENT_NAME=datasetlabs-env
REGISTRY_NAME=datasetlabsregistry
IMAGE_NAME=worker
IMAGE_TAG=$(git rev-parse --short HEAD)-$(date +%H%M%S)

# Container settings
CPU=2.0
MEMORY=4.0Gi
MIN_REPLICAS=0
MAX_REPLICAS=10

# KEDA Scaling
MESSAGE_COUNT=3
POLLING_INTERVAL=10
COOLDOWN=300
SERVICE_BUS_NAMESPACE=datasetlabs-bus
QUEUE_NAME=jobs