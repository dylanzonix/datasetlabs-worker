# deploy_chat.config — chat worker FastAPI deployment configuration

# Azure resources (sharing the worker RG + ACR + env)
RESOURCE_GROUP=datasetlabs-rg
CONTAINER_APP_NAME=datasetlabs-chat-api
ENVIRONMENT_NAME=datasetlabs-env
REGISTRY_NAME=datasetlabsregistry
IMAGE_NAME=worker
IMAGE_TAG=$(git rev-parse --short HEAD)-$(date +%H%M%S)

# Container settings
CPU=1.0
MEMORY=2.0Gi
MIN_REPLICAS=1                 # warm — chat is user-facing, cold start is bad UX
MAX_REPLICAS=10

# HTTP scaler — scale up when concurrent requests per replica exceeds this
CONCURRENT_REQUESTS=5

# Service exposes HTTP on this port (entrypoint_chat.sh reads $PORT)
TARGET_PORT=8040

# Origins allowed to call the chat API (passed as CHAT_API_ALLOWED_ORIGINS env)
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:3000
