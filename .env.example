EXTRACTION_PASSTHROUGH=

GENERATION_MODEL=

LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=

# Sandbox service (nsjail VM)
SANDBOX_SERVICE_URL=http://localhost:8010

# Browser Use Cloud (https://cloud.browser-use.com)
BROWSER_USE_API_KEY=
BROWSER_USE_PROXY_COUNTRY=us

# Apollo.io (optional — B2B contact/company data)
