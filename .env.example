# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Supabase (dev project)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# For backend verification: JWKS endpoint derived from SUPABASE_URL
# (you can hardcode or compute)
SUPABASE_JWKS_URL=

# Postgres (server-only, never in frontend)
DATABASE_URL=

# Azure Blob Storage (create if needed, or use empty string for testing)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER_NAME=
AZURE_STORAGE_SAS_EXPIRY_MINUTES=

# Azure Service Bus (from step 1.3)
AZURE_SERVICE_BUS_CONNECTION_STRING=
AZURE_SERVICE_BUS_QUEUE_NAME=

BILLING_MARGIN_MULTIPLIER=
BILLING_CHARGE_THRESHOLD_CENTS=
BILLING_CHARGE_INTERVAL_SECONDS=

EXTRACTION_PASSTHROUGH=

GENERATION_MODEL=

LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=

# Browser proxy (Bright Data residential, optional — leave blank to disable)
# Geo-pinning is set in the username: brd-customer-XXX-zone-residential-country-us-state-newyork
BROWSER_PROXY_SERVER=
BROWSER_PROXY_USERNAME=
BROWSER_PROXY_PASSWORD=

# Brave Search
BRAVE_API_KEY=

